# Copy this file to .env and fill in real values. Never commit .env.

# MongoDB connection string
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/vrinda_resort?retryWrites=true&w=majority

# Secret used to sign admin JWTs. REQUIRED — the server refuses to start
# without it, or if it is shorter than 32 characters (a short secret can be
# brute-forced offline). Generate one with: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-secret

# How long an admin session lasts (zeit/ms format: 15m, 8h, 1d)
JWT_EXPIRES_IN=1d

# Per-account login lockout (on top of the IP-based rate limiter on /login).
# After this many consecutive wrong passwords for the same email, that
# account is locked for ACCOUNT_LOCK_MINUTES regardless of which IP is trying.
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_MINUTES=15

# Forgot-password OTP (emailed via the same SMTP account configured below).
# A code expires after OTP_EXPIRY_MINUTES and is invalidated outright after
# MAX_OTP_ATTEMPTS wrong guesses, forcing a fresh forgot-password request.
OTP_EXPIRY_MINUTES=10
MAX_OTP_ATTEMPTS=5

# Port the API listens on (Render sets this automatically)
PORT=5000

# Comma-separated list of browser origins allowed to call the API
ALLOWED_ORIGINS=https://vrindavalleyresort.com,https://www.vrindavalleyresort.com,http://localhost:3000

# How long an identical booking is treated as a duplicate (seconds)
DUPLICATE_WINDOW_SECONDS=300

# SMTP account used to send booking notification emails (Nodemailer).
# For Gmail: EMAIL_HOST=smtp.gmail.com, EMAIL_PORT=587, EMAIL_USER=your address,
# EMAIL_PASS=a 16-character Google "App Password" (not your regular password —
# App Passwords require 2-Step Verification to be enabled on the account).
# If these are left unset, bookings still save normally; email sending is
# skipped with a warning in the logs instead of failing the request.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=replace-with-sending-address@example.com
EMAIL_PASS=replace-with-smtp-app-password

# Inbox that receives the "New Booking Received" notification for every booking.
OWNER_EMAIL=replace-with-owner-inbox@example.com

# error | warn | info | debug
LOG_LEVEL=info

NODE_ENV=production
